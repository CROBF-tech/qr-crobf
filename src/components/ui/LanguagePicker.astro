---
import { getLocaleFromPath } from '../../i18n/utils';
import type { Locale } from '../../i18n/utils';

const locale = getLocaleFromPath(Astro.url.pathname);
const altLocale: Locale = locale === 'en' ? 'es' : 'en';
const currentPath = Astro.url.pathname;

function swapLocale(path: string, current: Locale, target: Locale): string {
  if (current === 'en') {
    return target === 'es' ? (path === '/' ? '/es/' : `/es${path}`) : path;
  }
  const noPrefix = path.replace(/^\/es\/?/, '/');
  return target === 'en' ? noPrefix : path;
}

const altPath = swapLocale(currentPath, locale, altLocale);
const altLabel = altLocale === 'en' ? 'English' : 'Español';
---

<a
  href={altPath}
  hreflang={altLocale}
  aria-label={`Switch language to ${altLabel}`}
  class="font-mono text-xs uppercase tracking-wider text-text-soft hover:text-text px-2 py-1 rounded-sm transition-colors"
>
  {altLabel}
</a>
