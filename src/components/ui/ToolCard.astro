---
interface Props {
  href: string;
  icon?: string;
  title: string;
  description: string;
  category: string;
}

const { href, icon, title, description, category } = Astro.props;
---

<a
  href={href}
  class="group block border border-border bg-surface hover:border-text hover:bg-surface-elevated transition-all duration-200 p-4 md:p-6 rounded-md focus-visible:border-accent"
>
  <div class="flex items-center justify-between gap-3 mb-3">
    <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-accent">{category}</span>
    {icon && (
      <span class="text-text-soft group-hover:text-accent transition-colors" aria-hidden="true" set:html={icon} />
    )}
  </div>
  <h3 class="font-display text-lg md:text-xl font-medium leading-tight mb-2">{title}</h3>
  <p class="text-sm text-text-soft leading-relaxed mb-4">{description}</p>
  <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-text-soft group-hover:text-accent transition-colors">
    <span aria-hidden="true">→</span>
  </span>
</a>
