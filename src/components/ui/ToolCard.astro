---
interface Props {
  href: string;
  icon: string;
  title: string;
  description: string;
  category: string;
}

const { href, icon, title, description, category } = Astro.props;
---

<a
  href={href}
  class="group block border border-border bg-surface hover:border-accent hover:bg-bg transition-all duration-200 p-4 md:p-6"
>
  <div class="flex items-center gap-3 mb-3">
    <span class="text-accent text-lg" aria-hidden="true">{icon}</span>
    <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-accent">{category}</span>
  </div>
  <h3 class="font-display text-lg md:text-xl font-medium leading-tight mb-2">{title}</h3>
  <p class="text-sm text-text-soft leading-relaxed">{description}</p>
  <div class="mt-3 flex items-center gap-2 text-text-soft opacity-0 group-hover:opacity-100 translate-x-0 group-hover:translate-x-1 transition-all duration-200">
    <span class="font-mono text-xs">→</span>
  </div>
</a>
