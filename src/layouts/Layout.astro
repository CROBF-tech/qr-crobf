---
import '../styles/global.css';
import Container from '../components/ui/Container.astro';
import LanguagePicker from '../components/ui/LanguagePicker.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import { getTranslations, getLocaleFromPath, type Locale } from '../i18n/utils';

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  ogLocale?: string;
}

const {
  title,
  description,
  locale,
  canonicalPath,
  ogLocale,
} = Astro.props;

const t = getTranslations(locale);
const siteUrl = 'https://qr.crobf.tech';
const altLocale: Locale = locale === 'en' ? 'es' : 'en';

function buildAltPath(path: string, targetLocale: Locale): string {
  if (targetLocale === 'en') return path.replace(/^\/es\/?/, '/');
  return path === '/' ? '/es/' : `/es${path}`;
}

const altPath = buildAltPath(canonicalPath, altLocale);
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const altUrl = `${siteUrl}${altPath}`;
const ogLocaleTag = ogLocale || (locale === 'en' ? 'en_US' : 'es_ES');

const homePath = locale === 'en' ? '/' : '/es/';
const tools = [
  { href: locale === 'en' ? '/tools/qr' : '/es/tools/qr', label: t.navQrGenerator!, key: 'qr' },
  { href: locale === 'en' ? '/tools/barcode' : '/es/tools/barcode', label: t.navBarcodeGenerator!, key: 'barcode' },
  { href: locale === 'en' ? '/tools/scan-qr' : '/es/tools/scan-qr', label: t.navQrScanner!, key: 'scan-qr' },
  { href: locale === 'en' ? '/tools/scan-barcode' : '/es/tools/scan-barcode', label: t.navBarcodeScanner!, key: 'scan-barcode' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl} />
    <link rel="alternate" hreflang={altLocale} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonicalUrl : altUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocaleTag} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.brandName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: t.brandName,
      description: t.siteTagline,
      url: siteUrl,
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description: description,
      url: canonicalUrl,
      inLanguage: locale,
    })} />

    <script>
      const STORAGE_KEY = 'theme';
      const stored = typeof localStorage !== 'undefined' ? localStorage.getItem(STORAGE_KEY) : null;
      if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="min-h-screen bg-bg text-text transition-colors duration-200">
    <a href="#main" data-sr-only>Skip to content</a>

    <header aria-label="Primary" class="border-b border-border sticky top-0 z-30 bg-bg/80 backdrop-blur-sm">
      <Container size="xl">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-8">
            <a href={homePath} class="flex items-center gap-2.5 text-text hover:text-accent transition-colors" aria-label={t.brandName}>
              <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="32" height="32" rx="6" fill="var(--text)"/>
                <rect x="5" y="5" width="8" height="8" rx="2" fill="var(--accent)"/>
                <rect x="19" y="5" width="8" height="8" rx="2" fill="var(--accent)"/>
                <rect x="5" y="19" width="8" height="8" rx="2" fill="var(--accent)"/>
                <rect x="19" y="19" width="8" height="8" rx="2" fill="var(--accent)"/>
                <rect x="8" y="8" width="2" height="2" rx="0.5" fill="var(--bg)"/>
                <rect x="22" y="8" width="2" height="2" rx="0.5" fill="var(--bg)"/>
                <rect x="8" y="22" width="2" height="2" rx="0.5" fill="var(--bg)"/>
              </svg>
              <span class="font-mono text-xs tracking-wider hidden sm:inline">{t.brandName}</span>
            </a>
            <nav aria-label="Tools" class="hidden md:flex items-center gap-1">
              {tools.map((tool) => {
                const isActive = currentPath === tool.href || (tool.key !== 'qr' && tool.key !== 'barcode' && currentPath.startsWith(tool.href));
                return (
                  <a
                    href={tool.href}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider rounded-sm transition-colors',
                      isActive
                        ? 'text-text bg-surface'
                        : 'text-text-soft hover:text-text hover:bg-surface/60',
                    ]}
                  >
                    {tool.label}
                  </a>
                );
              })}
            </nav>
          </div>
          <div class="flex items-center gap-1 sm:gap-2">
            <LanguagePicker />
            <ThemeToggle />
          </div>
        </div>
        <nav aria-label="Tools" class="md:hidden flex items-center gap-1 pb-3 overflow-x-auto -mx-1 px-1">
          {tools.map((tool) => {
            const isActive = currentPath === tool.href;
            return (
              <a
                href={tool.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'shrink-0 px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider rounded-sm transition-colors border',
                  isActive
                    ? 'text-text border-border bg-surface'
                    : 'text-text-soft border-transparent hover:text-text',
                ]}
              >
                {tool.label}
              </a>
            );
          })}
        </nav>
      </Container>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer aria-label="Site footer" class="border-t border-border mt-12 md:mt-16">
      <Container size="xl">
        <div class="py-8 md:py-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
          <div>
            <p class="font-display text-lg font-medium mb-1">{t.footerBrand}</p>
            <p class="text-sm text-text-soft">{t.footerTagline}</p>
          </div>
          <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <a href={homePath} class="font-mono text-[11px] uppercase tracking-wider text-text-soft hover:text-text">{t.footerHome}</a>
            <a href={locale === 'en' ? '/tools/qr' : '/es/tools/qr'} class="font-mono text-[11px] uppercase tracking-wider text-text-soft hover:text-text">{t.footerAllTools}</a>
            <a href="https://github.com/CROBF-tech/qr-crobf" class="font-mono text-[11px] uppercase tracking-wider text-text-soft hover:text-text" target="_blank" rel="noopener noreferrer">{t.footerSource}</a>
          </nav>
        </div>
      </Container>
    </footer>
  </body>
</html>
