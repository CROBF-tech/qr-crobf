---
import Layout from '../../../layouts/Layout.astro';
import Container from '../../../components/ui/Container.astro';
import { QRGenerator } from '../../../components/QRGenerator';
import { getTranslations, getLocaleFromPath } from '../../../i18n/utils';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
---

<Layout
  title={t.qrPageTitle!}
  description={t.qrPageDescription!}
  locale={locale}
  canonicalPath="/es/tools/qr"
  ogLocale="es_ES"
>
  <Container size="xl" class="py-8 md:py-12">
    <div class="mb-8 max-w-2xl">
      <div class="flex items-center gap-2 mb-4 font-mono text-[11px] uppercase tracking-wider">
        <a href="/es/" class="text-text-soft hover:text-text transition-colors">
          {t.backToTools}
        </a>
        <span class="text-text-soft" aria-hidden="true">/</span>
        <span class="text-accent">{t.qrPageBreadcrumb}</span>
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-medium leading-tight tracking-tight mb-3">
        {t.qrPageTitle}
      </h1>
      <p class="text-base text-text-soft leading-relaxed">{t.qrPageDescription}</p>
    </div>
    <QRGenerator locale={locale} client:only="react" />
  </Container>
</Layout>
