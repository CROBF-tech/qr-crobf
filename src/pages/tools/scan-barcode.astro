---
import Layout from '../../layouts/Layout.astro';
import { BarcodeScannerComponent } from '../../components/tools/BarcodeScanner';
import { getTranslations, getLocaleFromPath } from '../../i18n/utils';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
const homePath = locale === 'en' ? '/' : '/es/';
---

<Layout
  title={t.barcodeScannerPageTitle}
  description={t.barcodeScannerPageDescription}
  locale={locale}
  canonicalPath="/tools/scan-barcode"
>
  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-8 md:py-12">
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-4">
        <a href={homePath} class="font-mono text-xs text-text-soft hover:text-text transition-colors">
          {t.backToTools}
        </a>
        <span class="text-text-soft text-xs">/</span>
        <span class="font-mono text-xs text-accent">{t.barcodeScannerPageBreadcrumb}</span>
      </div>
      <h1 class="font-display text-2xl md:text-3xl font-medium mb-2">{t.barcodeScannerPageTitle}</h1>
      <p class="text-sm md:text-base text-text-soft">{t.barcodeScannerPageDescription}</p>
    </div>
    <div class="max-w-lg">
      <BarcodeScannerComponent locale={locale} client:only="react" />
    </div>
  </div>
</Layout>
