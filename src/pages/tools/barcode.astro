---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import { BarcodeGenerator } from '../../components/BarcodeGenerator';
import { getTranslations, getLocaleFromPath } from '../../i18n/utils';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
const homePath = locale === 'en' ? '/' : '/es/';
---

<Layout
  title={t.barcodePageTitle!}
  description={t.barcodePageDescription!}
  locale={locale}
  canonicalPath="/tools/barcode"
>
  <Container size="xl" class="py-8 md:py-12">
    <div class="mb-8 max-w-2xl">
      <div class="flex items-center gap-2 mb-4 font-mono text-[11px] uppercase tracking-wider">
        <a href={homePath} class="text-text-soft hover:text-text transition-colors">
          {t.backToTools}
        </a>
        <span class="text-text-soft" aria-hidden="true">/</span>
        <span class="text-accent">{t.barcodePageBreadcrumb}</span>
      </div>
      <h1 class="font-display text-3xl md:text-4xl font-medium leading-tight tracking-tight mb-3">
        {t.barcodePageTitle}
      </h1>
      <p class="text-base text-text-soft leading-relaxed">{t.barcodePageDescription}</p>
    </div>
    <BarcodeGenerator locale={locale} client:only="react" />
  </Container>
</Layout>
