---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getLocaleFromPath } from '../../i18n/utils';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);
const homePath = locale === 'en' ? '/' : '/es/';
---

<Layout
  title={t.qrPageTitle!}
  description={t.qrPageDescription!}
  locale={locale}
  canonicalPath="/tools/qr"
>
  <div class="max-w-350 mx-auto px-4 md:px-6 py-8 md:py-12">
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-4">
        <a href={homePath} class="font-mono text-xs text-text-soft hover:text-text transition-colors">
          {t.backToTools}
        </a>
        <span class="text-text-soft text-xs">/</span>
        <span class="font-mono text-xs text-accent">{t.qrPageBreadcrumb}</span>
      </div>
      <h1 class="font-display text-2xl md:text-3xl font-medium mb-2">{t.qrPageTitle}</h1>
      <p class="text-sm md:text-base text-text-soft">{t.qrPageDescription}</p>
    </div>
    <p class="font-mono text-sm text-text-soft">No disponible hoy</p>
  </div>
</Layout>
